## 4. Props 인터페이스 설계 (권장)

```ts
// ProductCard
type ProductCardProps = {
  product: Product;
  href?: string;
  onAddToCart?: () => void;
  onWishlistToggle?: () => void;
  badgeSlot?: React.ReactNode;
  loading?: boolean;
  className?: string;
};

// ProductGrid
type ProductGridProps = {
  products: Product[];
  columns?: { sm?: number; md?: number; lg?: number };
  gap?: number | string;
  renderItem?: (p: Product) => React.ReactNode;
  emptyState?: React.ReactNode;
  loading?: boolean;
  className?: string;
};

// CartItemRow
type CartItemRowProps = {
  name: string;
  imageUrl?: string;
  variantLabel?: string;
  quantity: number;
  unitPrice: number;
  lineTotal?: number;
  currency?: string;
  onQuantityChange?: (n: number) => void;
  onRemove?: () => void;
  disabled?: boolean;
  className?: string;
};

// RatingStars
type RatingStarsProps = {
  value: number;
  max?: number;
  size?: "sm" | "md";
  className?: string;
  "aria-label"?: string;
};

// ReviewCard
type ReviewCardProps = {
  authorName: string;
  avatarUrl?: string;
  rating: number;
  body: string;
  date?: string;
  className?: string;
};

// QuantitySelector
type QuantitySelectorProps = {
  value: number;
  min?: number;
  max?: number;
  onChange: (n: number) => void;
  variant?: "cart" | "product";
  disabled?: boolean;
  className?: string;
};

// OrderSummaryPanel
type OrderSummaryLine = { id: string; label: string; amount: number; muted?: boolean };
type OrderSummaryPanelProps = {
  lines: OrderSummaryLine[];
  totalAmount: number;
  currency?: string;
  primaryCta?: { label: string; onClick: () => void; disabled?: boolean; loading?: boolean };
  footnote?: string;
  className?: string;
};
```

